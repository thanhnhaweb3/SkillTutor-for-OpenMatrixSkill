# SkillTutor – copy the lines you need into .env (never commit real secrets).
# Run `npm run check:skilltutor-readiness` after editing.

# --- Core ---
SKILLTUTOR_ENABLED=true
# language for learners without a profile language and for unknown numbers (vi | en)
SKILLTUTOR_DEFAULT_LOCALE=en
# true = seeded in-memory OMS (CTW Academy demo course); false in production
SKILLTUTOR_DEMO=false
# Expert IDs whose active cohorts are listed on the landing page (comma-separated, e.g. expert-olym3)
SKILLTUTOR_PUBLIC_EXPERT_IDS=
# must be EXACTLY the public origin – POSTs from any other origin are rejected (403 MISSING_PERMISSION)
NEXT_PUBLIC_APP_URL=https://skilltutor.openmatrixskill.com
# one AWS account/region for everything (IAM user: skilltutor)
AWS_REGION=ap-southeast-2
# Sign-in (Cognito, user pool in Sydney)
AC_PRIMARY_ADAPTER=cognito
COGNITO_REGION=ap-southeast-2
COGNITO_USER_POOL_ID=ap-southeast-2_JC9WkIloL
COGNITO_CLIENT_ID=6g02fdeir6gat51phc1gu43l1l
# copy from Cognito → App clients → My web app - skilltutor (leave empty if the client has no secret)
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=ap-southeast-2jc9wkilol.auth.ap-southeast-2.amazoncognito.com
COGNITO_REDIRECT_URI=https://skilltutor.openmatrixskill.com/api/ac/auth/callback
# must match the scopes ticked in the app client (add "profile" there, or drop it here)
COGNITO_SCOPES=openid email phone

# --- OMS delivery (SkillTutor records lesson completion through DeliveryService) ---
DASHBOARD_PROGRESS_ENABLED=true
# lets the first admin create their Expert workspace by opening /dashboard
DASHBOARD_LEVEL0_BOOTSTRAP_ENABLED=true
DASHBOARD_MUTATIONS_ENABLED=true
DASHBOARD_ENROLLMENTS_ENABLED=true
DASHBOARD_DELIVERY_CANARY_EXPERT_IDS=*

# --- Agent ---
# Engine of the SkillTutor AI chat bubble: mock = rule-based replies (no AWS call), bedrock = Claude on Amazon Bedrock
SKILLTUTOR_LLM_MODE=bedrock
# Engine of the WhatsApp/SMS thread and "Learn on the web": rules = structured flow, no AI cost (default) | bedrock = Claude too
SKILLTUTOR_PHONE_ENGINE=rules
# messages = Anthropic Messages API (InvokeModel, native Claude body) | converse = Bedrock Converse API
SKILLTUTOR_BEDROCK_API=messages
# Bedrock runtime region (empty = AWS_REGION)
SKILLTUTOR_BEDROCK_REGION=ap-southeast-2
# outside US regions use the global (or regional) inference profile shown in the Bedrock console
SKILLTUTOR_BEDROCK_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
SKILLTUTOR_BEDROCK_ANTHROPIC_VERSION=bedrock-2023-05-31
# max output tokens per chat reply (the quiz generator asks for up to 4000 on its own)
SKILLTUTOR_BEDROCK_MAX_TOKENS=800
SKILLTUTOR_BEDROCK_TEMPERATURE=0.3
# optional; Claude 4.5 accepts temperature OR top_p – setting TOP_P drops TEMPERATURE
SKILLTUTOR_BEDROCK_TOP_P=
SKILLTUTOR_BEDROCK_TOP_K=
# optional, separated by |
SKILLTUTOR_BEDROCK_STOP_SEQUENCES=
SKILLTUTOR_BEDROCK_TIMEOUT_MS=25000
# total attempts incl. the first (retries throttling / 5xx)
SKILLTUTOR_BEDROCK_MAX_ATTEMPTS=3
# Anthropic prompt caching for system prompt + tools
SKILLTUTOR_BEDROCK_PROMPT_CACHE=false
# Test with: npm run check:bedrock

# --- Daily AI message quota (per learner, per channel; 0 = unlimited) ---
# Quiz answers A–D and language/course switches don't count. Resets at 00:00 in SKILLTUTOR_TIME_ZONE.
SKILLTUTOR_DAILY_MESSAGE_LIMIT=10
# per-channel overrides (empty = SKILLTUTOR_DAILY_MESSAGE_LIMIT)
SKILLTUTOR_DAILY_LIMIT_WEB=
SKILLTUTOR_DAILY_LIMIT_WHATSAPP=
SKILLTUTOR_DAILY_LIMIT_SMS=
# staff simulator: unlimited by default
SKILLTUTOR_DAILY_LIMIT_SIMULATOR=0
# local = agent loop in Next.js, agentcore = InvokeAgentRuntime
SKILLTUTOR_AGENT_MODE=local
SKILLTUTOR_AGENTCORE_RUNTIME_ARN=
SKILLTUTOR_PASS_SCORE=0.7
SKILLTUTOR_TIME_ZONE=Asia/Ho_Chi_Minh

# --- Customer Delivery Services ---
# dryrun = messages go to the Outbox, live = End User Messaging / SES
SKILLTUTOR_CHANNELS_MODE=dryrun
SKILLTUTOR_WHATSAPP_PHONE_NUMBER_ID=phone-number-id-xxxxxxxxxxxxxxxx
SKILLTUTOR_WHATSAPP_DISPLAY_NUMBER=+84900000000
# Meta Graph API version (v20.0 was retired on 2026-09-24)
SKILLTUTOR_WHATSAPP_META_API_VERSION=v25.0
SKILLTUTOR_WHATSAPP_NUDGE_TEMPLATE=skilltutorreminder
# language codes exactly as the approved template versions in WhatsApp Manager
# only an English version exists → use it for Vietnamese learners too
SKILLTUTOR_WHATSAPP_TEMPLATE_LANG=en
SKILLTUTOR_WHATSAPP_TEMPLATE_LANG_EN=en
# template body variables in order ({{1}},{{2}}…): name, lesson, course, minutes – empty if the body has none
SKILLTUTOR_WHATSAPP_TEMPLATE_PARAMS=name,lesson
SKILLTUTOR_SMS_ORIGINATION_IDENTITY=
SKILLTUTOR_SMS_DISPLAY_NUMBER=
SKILLTUTOR_SMS_CONFIGURATION_SET=
SKILLTUTOR_SES_FROM_EMAIL=OpenMatrix Skill <tutor@openmatrixskill.com>
SKILLTUTOR_SES_CONFIGURATION_SET=

# --- Storage & security ---
# memory = lost on restart, dynamodb = run `npm run setup:skilltutor-dynamodb`
# create all tables with: npm run setup:aws-tables
DASHBOARD_STORE=dynamodb
AC_USER_STORE=dynamodb
SKILLTUTOR_STORE=dynamodb
DYNAMODB_DASHBOARD_TABLE=OpenMatrixDashboard
DYNAMODB_DASHBOARD_AUDIT_TABLE=OpenMatrixDashboardAudit
DYNAMODB_USERS_TABLE=OpenMatrixUsers
DYNAMODB_SKILLTUTOR_TABLE=OpenMatrixSkillTutor
DYNAMODB_DASHBOARD_USER_INDEX=GSI1
DYNAMODB_DASHBOARD_SKILLS_INDEX=GSI2
DYNAMODB_DASHBOARD_COURSES_INDEX=GSI2
DYNAMODB_DASHBOARD_DELIVERY_INDEX=GSI2
# >= 16 random chars; EventBridge sends it as the x-cron-secret header
# signs the login cookie – long random string (e.g. `openssl rand -base64 32`); changing it signs everyone out
AC_SESSION_SECRET=
SKILLTUTOR_CRON_SECRET=
# keep true in production (SNS signature verification)
SKILLTUTOR_VERIFY_SNS=true
