{
  "name": "skilltutor-openmatrixskill-com",
  "version": "0.6.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:dashboard": "tsx --test packages/dashboard/test/*.test.ts",
    "test:ac-login": "tsx --test packages/oms-ac-login/test/*.test.ts",
    "test:vi-en": "tsx --test src/i18n/*.test.ts",
    "check:users-dynamodb": "node --env-file=.env scripts/check-users-dynamodb.mjs",
    "check:dashboard-dynamodb": "node --env-file=.env scripts/check-dashboard-dynamodb.mjs",
    "check:dashboard-audit-dynamodb": "node --env-file=.env scripts/check-dashboard-audit-dynamodb.mjs",
    "check:dashboard-skills-dynamodb": "node --env-file=.env scripts/check-dashboard-skills-dynamodb.mjs",
    "check:dashboard-skills-write-iam": "node --env-file=.env scripts/check-dashboard-skills-write-iam.mjs",
    "check:dashboard-phase3-dynamodb": "node --env-file=.env scripts/check-dashboard-phase3-dynamodb.mjs",
    "check:dashboard-phase3-live": "node scripts/check-dashboard-phase3-live.mjs",
    "check:dashboard-phase3-live:disabled": "PHASE3_LIVE_EXPECTED_MODE=disabled node scripts/check-dashboard-phase3-live.mjs",
    "check:dashboard-phase3-canary-readiness": "node --env-file=.env scripts/check-dashboard-phase3-canary-readiness.mjs",
    "configure:dashboard-cloudwatch-alarms": "node --env-file=.env scripts/configure-dashboard-cloudwatch-alarms.mjs",
    "validate:skill-framework-seed": "tsx scripts/validate-skill-framework-seed.ts",
    "seed:skill-framework": "tsx --env-file=.env scripts/seed-skill-framework.ts",
    "test:skilltutor": "tsx --test packages/skilltutor/test/*.test.ts",
    "skilltutor:agentcore": "tsx packages/skilltutor/agentcore/server.ts",
    "setup:skilltutor-dynamodb": "node --env-file=.env scripts/setup-skilltutor-dynamodb.mjs",
    "check:skilltutor-readiness": "node --env-file=.env scripts/check-skilltutor-readiness.mjs",
    "check:bedrock": "tsx --env-file=.env scripts/check-bedrock.ts",
    "check:whatsapp-link": "tsx --env-file=.env scripts/check-whatsapp-link.ts",
    "seed:course": "tsx --env-file=.env scripts/seed-course.ts",
    "setup:aws-tables": "node --env-file=.env scripts/setup-aws-tables.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agentcore": "^3.1152.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1152.0",
    "@aws-sdk/client-dynamodb": "^3.1083.0",
    "@aws-sdk/client-pinpoint-sms-voice-v2": "^3.1152.0",
    "@aws-sdk/client-sesv2": "^3.1152.0",
    "@aws-sdk/client-socialmessaging": "^3.1152.0",
    "@aws-sdk/lib-dynamodb": "^3.1083.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudwatch": "^3.1090.0",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.5",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.23.1",
    "typescript": "^5.5.3"
  }
}
