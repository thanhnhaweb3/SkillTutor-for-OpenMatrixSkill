{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@openmatrix/dashboard": ["packages/dashboard/src/index.ts"],
      "@openmatrix/dashboard/*": ["packages/dashboard/src/*"],
      "@openmatrix/oms-ac-login": ["packages/oms-ac-login/src/index.ts"],
      "@openmatrix/oms-ac-login/*": ["packages/oms-ac-login/src/*"],
      "@openmatrix/skilltutor": ["packages/skilltutor/src/index.ts"],
      "@openmatrix/skilltutor/next": ["packages/skilltutor/src/next/index.ts"],
      "@openmatrix/skilltutor/bilingual": ["packages/skilltutor/src/bilingual.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
